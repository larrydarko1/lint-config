{
    "name": "@larrydarko/lint-config",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Shared formatting, commit and style configuration for Larry's projects.",
    "license": "UNLICENSED",
    "engines": {
        "node": ">=24"
    },
    "exports": {
        ".": "./src/index.js",
        "./commitlint": "./src/commitlint.js",
        "./eslint": "./src/eslint/index.js",
        "./eslint/electron": "./src/eslint/electron/index.js",
        "./eslint/fullstack": "./src/eslint/fullstack/index.js",
        "./eslint/presets": "./src/eslint/presets.js",
        "./gates/audit": {
            "types": "./src/gates/audit.d.ts",
            "default": "./src/gates/audit.js"
        },
        "./gates/code-style": {
            "types": "./src/gates/code-style.d.ts",
            "default": "./src/gates/code-style.js"
        },
        "./gates/dead-code": {
            "types": "./src/gates/dead-code.d.ts",
            "default": "./src/gates/dead-code.js"
        },
        "./gates/declaration-order": {
            "types": "./src/gates/declaration-order.d.ts",
            "default": "./src/gates/declaration-order.js"
        },
        "./gates/duplication": {
            "types": "./src/gates/duplication.d.ts",
            "default": "./src/gates/duplication.js"
        },
        "./gates/env-drift": {
            "types": "./src/gates/env-drift.d.ts",
            "default": "./src/gates/env-drift.js"
        },
        "./gates/error-handling/electron": {
            "types": "./src/gates/error-handling/electron.d.ts",
            "default": "./src/gates/error-handling/electron.js"
        },
        "./gates/error-handling/fullstack": {
            "types": "./src/gates/error-handling/fullstack.d.ts",
            "default": "./src/gates/error-handling/fullstack.js"
        },
        "./gates/files": {
            "types": "./src/gates/files.d.ts",
            "default": "./src/gates/files.js"
        },
        "./gates/html-standards": {
            "types": "./src/gates/html-standards.d.ts",
            "default": "./src/gates/html-standards.js"
        },
        "./gates/i18n": {
            "types": "./src/gates/i18n.d.ts",
            "default": "./src/gates/i18n.js"
        },
        "./gates/import-order": {
            "types": "./src/gates/import-order.d.ts",
            "default": "./src/gates/import-order.js"
        },
        "./gates/package-json": {
            "types": "./src/gates/package-json.d.ts",
            "default": "./src/gates/package-json.js"
        },
        "./gates/pipeline": {
            "types": "./src/gates/pipeline.d.ts",
            "default": "./src/gates/pipeline.js"
        },
        "./gates/refactoring": {
            "types": "./src/gates/refactoring.d.ts",
            "default": "./src/gates/refactoring.js"
        },
        "./gates/repo-root": {
            "types": "./src/gates/repo-root.d.ts",
            "default": "./src/gates/repo-root.js"
        },
        "./gates/report": {
            "types": "./src/gates/report.d.ts",
            "default": "./src/gates/report.js"
        },
        "./gates/scss-standards": {
            "types": "./src/gates/scss-standards.d.ts",
            "default": "./src/gates/scss-standards.js"
        },
        "./gates/strip-comments": {
            "types": "./src/gates/strip-comments.d.ts",
            "default": "./src/gates/strip-comments.js"
        },
        "./gates/swallowed-errors": {
            "types": "./src/gates/swallowed-errors.d.ts",
            "default": "./src/gates/swallowed-errors.js"
        },
        "./gates/testing": {
            "types": "./src/gates/testing.d.ts",
            "default": "./src/gates/testing.js"
        },
        "./gates/tsconfigs": {
            "types": "./src/gates/tsconfigs.d.ts",
            "default": "./src/gates/tsconfigs.js"
        },
        "./lint-staged": "./src/lint-staged.js",
        "./prettier": "./src/prettier.js",
        "./stylelint": "./src/stylelint.js"
    },
    "files": [
        "src"
    ],
    "scripts": {
        "verify": "node scripts/verify.js",
        "test": "node --test test/*.test.js",
        "snapshot": "node scripts/eslint-snapshot.js"
    },
    "dependencies": {
        "@commitlint/config-conventional": "^21.2.2",
        "@eslint/js": "^10.0.1",
        "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vue/compiler-sfc": "^3.5.43",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-vue": "^10.11.0",
        "eslint-plugin-vuejs-accessibility": "^2.6.0",
        "globals": "^17.12.0",
        "jsonc-eslint-parser": "^3.3.0",
        "postcss-html": "^2.0.0",
        "postcss-scss": "^4.0.9",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-declaration-strict-value": "^1.12.1",
        "stylelint-scss": "^7.2.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.70.1",
        "yaml": "^2.9.1"
    },
    "peerDependencies": {
        "@commitlint/cli": "^21.2.2",
        "eslint": "^10.0.0",
        "prettier": "^3.8.0",
        "stylelint": "^17.0.0"
    },
    "peerDependenciesMeta": {
        "@commitlint/cli": {
            "optional": true
        },
        "stylelint": {
            "optional": true
        },
        "eslint": {
            "optional": true
        }
    },
    "devDependencies": {
        "eslint": "^10.11.0",
        "prettier": "^3.9.8",
        "stylelint": "^17.15.0"
    }
}
