{
    "name": "@larrydarko/lint-config",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Shared formatting, commit and style configuration for Larry's projects.",
    "license": "UNLICENSED",
    "engines": {
        "node": ">=24"
    },
    "exports": {
        ".": "./src/index.js",
        "./prettier": "./src/prettier.js",
        "./commitlint": "./src/commitlint.js",
        "./stylelint": "./src/stylelint.js",
        "./lint-staged": "./src/lint-staged.js",
        "./eslint": "./src/eslint/index.js",
        "./eslint/presets": "./src/eslint/presets.js",
        "./eslint/electron": "./src/eslint/electron/index.js",
        "./eslint/fullstack": "./src/eslint/fullstack/index.js",
        "./gates/repo-root": {
            "types": "./src/gates/repo-root.d.ts",
            "default": "./src/gates/repo-root.js"
        },
        "./gates/strip-comments": {
            "types": "./src/gates/strip-comments.d.ts",
            "default": "./src/gates/strip-comments.js"
        },
        "./gates/import-order": {
            "types": "./src/gates/import-order.d.ts",
            "default": "./src/gates/import-order.js"
        }
    },
    "files": [
        "src"
    ],
    "scripts": {
        "verify": "node scripts/verify.js",
        "test": "node --test test/*.test.js",
        "snapshot": "node scripts/eslint-snapshot.js"
    },
    "dependencies": {
        "@commitlint/config-conventional": "^21.2.2",
        "@eslint/js": "^10.0.1",
        "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vue/compiler-sfc": "^3.5.43",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-vue": "^10.11.0",
        "eslint-plugin-vuejs-accessibility": "^2.6.0",
        "globals": "^17.12.0",
        "jsonc-eslint-parser": "^3.3.0",
        "postcss-html": "^2.0.0",
        "postcss-scss": "^4.0.9",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-declaration-strict-value": "^1.12.1",
        "stylelint-scss": "^7.2.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.70.1"
    },
    "peerDependencies": {
        "@commitlint/cli": "^21.2.2",
        "eslint": "^10.0.0",
        "prettier": "^3.8.0",
        "stylelint": "^17.0.0"
    },
    "peerDependenciesMeta": {
        "@commitlint/cli": {
            "optional": true
        },
        "stylelint": {
            "optional": true
        },
        "eslint": {
            "optional": true
        }
    },
    "devDependencies": {
        "eslint": "^10.11.0",
        "prettier": "^3.9.8",
        "stylelint": "^17.15.0"
    }
}
