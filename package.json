    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "prepack": "npm run build",
        "prepublishOnly": "npm run typecheck && npm test && npm run check:package",
        "verify": "node scripts/verify.js",
        "test": "node --test test/*.test.js",
        "snapshot": "node scripts/eslint-snapshot.js",
        "check:package": "node scripts/check-package.js"
    },
    "dependencies": {
        "@commitlint/config-conventional": "^21.2.2",
        "@eslint/js": "^10.0.1",
        "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
        "@typescript-eslint/utils": "^8.70.1",
