    "scripts": {
        "build": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "eslint .",
        "format:check": "prettier --check .",
        "prepack": "npm run build",
        "prepublishOnly": "npm run typecheck && npm test && npm run check:package",
        "test": "node --test test/*.test.js",
        "snapshot": "node scripts/eslint-snapshot.js",
        "presets:record": "node test/presets/record.js",
        "check:package": "node scripts/checks/check-publish.ts",
        "secrets:check": "node scripts/checks/check-secrets.ts",
        "licenses:check": "node scripts/checks/check-licenses.ts",
        "audit:check": "node scripts/checks/check-audit.ts",
        "style:check": "node scripts/checks/check-code-style.ts",
        "deadcode:check": "node scripts/checks/check-dead-code.ts",
        "order:check": "node scripts/checks/check-declaration-order.ts",
        "dup:check": "node scripts/checks/check-duplication.ts",
        "manifest:check": "node scripts/checks/check-package-json.ts",
        "pipeline:check": "node scripts/checks/check-pipeline.ts",
        "refactor:check": "node scripts/checks/check-refactoring.ts",
        "tsconfig:check": "node scripts/checks/check-tsconfigs.ts",
        "ci:check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run audit:check && npm run secrets:check && npm run licenses:check && npm run style:check && npm run deadcode:check && npm run order:check && npm run dup:check && npm run manifest:check && npm run pipeline:check && npm run refactor:check && npm run tsconfig:check && npm run check:package"
    },
